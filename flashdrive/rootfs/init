#!/bin/sh
# NativeRa Prototype - Phase 1 minimal init
# Reaches a text console to prove the boot chain
# (Limine -> kernel -> initramfs -> busybox shell).

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TERM=linux
export HOME=/

# --- pseudo filesystems ---
# The mountpoints must already exist in the cpio (build.sh creates them).
# A failed mount here is fatal to the rest of this script: no /proc means no
# uptime/mem, no /dev means no controlling tty. Report instead of continuing.
mkdir -p /proc /sys /dev /run

if ! mount -t proc none /proc; then
    echo "FATAL: could not mount /proc" >&2
fi
if ! mount -t sysfs none /sys; then
    echo "WARNING: could not mount /sys" >&2
fi

# devtmpfs first: it provides /dev/console and kernel-created nodes.
if ! mount -t devtmpfs none /dev 2>/dev/null; then
    echo "WARNING: devtmpfs unavailable, falling back to tmpfs" >&2
    mount -t tmpfs tmp /dev
fi

# --- console sanity: make sure we have a terminal ---
[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -e /dev/null ]    || mknod -m 666 /dev/null    c 1 3
[ -e /dev/tty ]     || mknod -m 666 /dev/tty     c 5 0

# --- console fallback --------------------------------------------------------
# /dev/console follows the LAST console= on the kernel cmdline. If that points
# at a serial port with nothing attached, everything init prints vanishes and
# the machine looks dead (black screen) even though it booted fine. Note that a
# serial port with nothing plugged in is still a valid tty, so `[ -t 1 ]` cannot
# detect this: the cmdline has to be parsed.
# This is a safety net, not the fix: limine.conf must still end with console=tty0.
LAST_CONSOLE="$(tr ' ' '\n' < /proc/cmdline 2>/dev/null | grep '^console=' | tail -1)"
case "$LAST_CONSOLE" in
    console=ttyS*|console=ttyUSB*)
        if [ -c /dev/tty0 ]; then
            echo "WARNING: /dev/console is $LAST_CONSOLE (no serial attached)." >&2
            echo "         Falling back to /dev/tty0 so output is visible." >&2
            exec >/dev/tty0 2>&1 </dev/tty0
        fi
        ;;
esac

banner() {
    # NOTE: no 'clear' during bring-up. It wipes any error output printed before
    # the banner, which is exactly the information needed to debug a bad boot.
    echo
    echo "  ================================================="
    echo "    NativeRa  -  Prototype Phase 1  (text console)"
    echo "  ================================================="
    echo "  Boot chain OK: Limine -> kernel -> initramfs -> sh"
    echo
    echo "  Kernel: $(uname -r)"
    echo "  Uptime: $(cut -d' ' -f1 /proc/uptime 2>/dev/null)s"
    echo "  Mem:    $(free -m 2>/dev/null | awk 'NR==2{print $2" MB total, "$7" MB avail"}')"
    echo
    echo "  Type 'ls /sys/firmware/efi' or 'dmesg | tail' to poke around."
    echo "  Type 'reboot' or 'poweroff' to restart."
    echo "  ================================================="
    echo
}

banner

# --- bring-up diagnostics ----------------------------------------------------
# Printed AFTER the banner so nothing can erase them. Remove once the chain is
# proven and the boot is quiet.
echo "  --- mount check ---"
for m in /proc /sys /dev; do
    if grep -q " $m " /proc/mounts 2>/dev/null; then
        echo "  $m: mounted"
    else
        echo "  $m: NOT MOUNTED"
    fi
done
echo "  /proc/uptime: $(cat /proc/uptime 2>/dev/null || echo unreadable)"
echo "  /dev entries: $(ls /dev 2>/dev/null | wc -l)"
echo "  tty devices:  $(ls /dev/tty* 2>/dev/null | tr '\n' ' ')"
echo "  -------------------"
echo

# --- networking (only present when built with NET=1) --------------------------
# The kernel ships every ethernet driver as a module, so nothing works until the
# right one is loaded. Try the common ones in order of likelihood; the first that
# creates an interface wins. Then DHCP, then dropbear.
if [ -x /usr/sbin/dropbear ]; then
    echo "  --- network ---"

    # Load NIC modules. modprobe needs modules.dep, which build.sh generates.
    # PHY drivers FIRST. A MAC driver probes the MDIO bus for a PHY by ID at
    # attach time; if no PHY driver is registered yet the link never comes up
    # and the interface reads as 00:00:00:00:00:00 with no carrier. They are not
    # modules.dep dependencies of the MAC driver, so modprobe will not pull them
    # in on its own - they have to be loaded explicitly, before the MAC.
    for p in realtek micrel broadcom marvell; do
        modprobe "$p" 2>/dev/null && echo "  loaded phy: $p"
    done

    for m in e1000e e1000 igb igc r8169; do
        modprobe "$m" 2>/dev/null && echo "  loaded: $m"
    done

    # Find an interface that is not loopback.
    IFACE=""
    for i in $(ls /sys/class/net 2>/dev/null); do
        [ "$i" = "lo" ] && continue
        IFACE="$i"
        break
    done

    if [ -z "$IFACE" ]; then
        echo "  no network interface found (no matching NIC driver)"
        echo "  loaded modules were:"
        lsmod 2>/dev/null | sed 's/^/    /'
    else
        echo "  interface: $IFACE"

        # An all-zero MAC means the driver bound but never read the hardware:
        # the PHY did not attach, or the device is not really present. DHCP
        # cannot work in that state, and the failure is silent otherwise.
        MAC="$(cat "/sys/class/net/$IFACE/address" 2>/dev/null)"
        echo "  mac: ${MAC:-unknown}"
        case "$MAC" in
            00:00:00:00:00:00|"")
                echo "  ERROR: $IFACE has no hardware address."
                echo "         The PHY did not attach. Likely causes:"
                echo "           - the PHY driver for this NIC is not in the image"
                echo "           - the NIC is not actually wired/enabled in firmware"
                echo "         Loaded phy modules:"
                lsmod 2>/dev/null | grep -E "phy|realtek|micrel|broadcom|marvell" | sed 's/^/           /'
                echo "         Skipping DHCP: it cannot succeed without a MAC."
                IFACE=""
                ;;
        esac
    fi

    if [ -n "$IFACE" ]; then
        ip link set "$IFACE" up 2>/dev/null
        # udhcpc obtains a lease and hands it to an event script, which is what
        # actually configures the address/route/resolv.conf. Without -s pointing
        # at a real script it exits 0 having applied nothing.
        # -q: quit after obtaining a lease. -n: exit if none obtained.
        if udhcpc -i "$IFACE" -s /usr/share/udhcpc/default.script -q -n -t 5 -T 3 >/dev/null 2>&1; then
            IP="$(ip -4 addr show "$IFACE" 2>/dev/null | awk '/inet /{print $2; exit}')"
            echo "  ip: ${IP:-none}"
            if [ -n "$IP" ]; then
                # Root has no password by default, so only key auth can work.
                # Generate a key on the stick if none was baked in.
                mkdir -p /root/.ssh
                chmod 700 /root/.ssh
                if [ ! -f /root/.ssh/authorized_keys ]; then
                    echo "  NOTE: no /root/.ssh/authorized_keys - ssh will refuse logins"
                    echo "        add your pubkey to the ESP as authorized_keys"
                fi
                echo "  starting dropbear on port 22 (key auth only)"
                # -s: disable PASSWORD logins (key auth still works).
                # NOT -w: in dropbear, -w means "Disallow root logins", which
                # rejects root outright and produces exactly the symptom seen
                # here - "root login rejected", "0 fails", key never checked.
                # -E: log to stderr so auth failures are visible.
                # Do not pipe dropbear into `head`: head exits, the pipe closes,
                # and dropbear takes SIGPIPE mid-authentication. Use a file.
                /usr/sbin/dropbear -R -s -E -p 22 2>/run/dropbear.log
                sleep 1
                if [ -s /run/dropbear.log ]; then
                    echo "  dropbear:"
                    head -5 /run/dropbear.log | sed 's/^/    /'
                fi
                echo "  ssh root@${IP%/*}"
            fi
        else
            echo "  dhcp failed on $IFACE"
        fi
    fi
    echo "  -------------------"
    echo
fi

# Drop into an interactive shell on the console.
#
# PID 1 is already a session leader with NO controlling tty, so `exec cttyhack
# /bin/sh` cannot work: cttyhack's setsid() fails with EPERM and you get
# "can't access tty; job control turned off" (no Ctrl-C, no fg/bg).
#
# The pattern busybox documents for exactly this case ("Starting interactive
# shell from boot shell script") is `setsid cttyhack sh`: setsid detaches into a
# fresh session, then cttyhack acquires the console as that session's
# controlling terminal. Verified in a VM.
echo "  Starting shell..."
echo

setsid cttyhack /bin/sh

# Shell exited: shut down cleanly instead of panicking the kernel.
echo
echo "  Shell exited. Powering off."
sync
exec poweroff -f
